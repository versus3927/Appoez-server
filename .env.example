# Токен Discord-бота (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Application ID бота (General Information → Application ID)
DISCORD_CLIENT_ID=your_client_id_here

# Строка подключения PostgreSQL
# Локально:   postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Railway:    добавьте reference ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
